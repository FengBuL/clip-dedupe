{
  "name": "clip-dedupe",
  "version": "1.0.0",
  "description": "Find and clean up duplicated blocks across notes: repeated clippings, daily dumps and AI reports.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint src",
    "test": "node scripts/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check:css": "node scripts/check-css.cjs styles.css",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:css && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "duplicates",
    "dedupe",
    "clippings"
  ],
  "author": "FengBuL",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "doiuse": "^6.0.6",
    "esbuild": "^0.23.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "postcss": "^8.5.29",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FengBuL/clip-dedupe.git"
  }
}
